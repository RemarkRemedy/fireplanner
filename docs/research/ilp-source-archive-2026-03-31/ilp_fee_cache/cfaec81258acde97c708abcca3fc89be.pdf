<script src='https://www.google.com/recaptcha/api.js'></script>

<script type="text/javascript">
    $(document).ready(function () {
        $(document).on("click", ".sample", function () {			
            var id = $(this).attr('id');
            var clickedID = '#' + id;           
            var conditions = $(clickedID).parent().parent().children('#Condition').val();	
            var classname = $(this).attr('class');
            if (conditions == 'Yes' && classname.indexOf('Yes') != -1 || conditions == 'No' && classname.indexOf('No') != -1 )
                {
                var Action = $(clickedID).parent().parent().children('#Action').val();
                var Select = $(clickedID).parent().parent().children('#Select').val();
                if (conditions == 'Yes' && Action == "Enable" && Select == "TextBox") {
                    $(clickedID).parent().parent().find('#divText').css('display', 'block');					
                }
                else if (conditions == 'Yes' && Action == "Enable" && Select == "Label") {
                    $(clickedID).parent().parent().find('#divLabel').css('display', 'block');
                }
                else if (conditions == 'No' && Action == "Enable" && Select == "TextBox") {
                    $(clickedID).parent().parent().find('#divText').css('display', 'block');
                }
                else if (conditions == 'No' && Action == "Enable" && Select == "Label") {
                    $(clickedID).parent().parent().find('#divLabel').css('display', 'block');
                }
                
            }
            else {
                $(clickedID).parent().parent().find('#divLabel').css('display', 'none');
                $(clickedID).parent().parent().find('#divText').css('display', 'none');
            }
           
		   if($(clickedID).parent().siblings('#divLabel').is(':visible'))
		   {
               $(clickedID).parent().siblings('#divText').find('input[type=text]').val("LabelYes");		
		   }
		   else{
		   $(clickedID).parent().siblings('#divText').find('input[type=text]').val("");
		   }
		   
        });
    });
  
</script>


<div value="value" class="form-group EUResident required">
    <input type="hidden" value="Yes" id="Condition" />
    <input type="hidden" value="Label" id="Select" />
    <input type="hidden" value="Enable" id="Action" />
    <input type="hidden" value="I understand that if I am an European Union (&amp;ldquo;EU&amp;rdquo;) resident individual (i.e. my residential address is based in any of the EU countries), I can refer to Prudential Privacy Notice (which is available at &lt;a rel=&quot;noopener noreferrer&quot; href=&quot;/Privacy-Notice&quot; target=&quot;_blank&quot; style=&quot;color: blue;&quot;&gt;https://www.prudential.com.sg/privacy-notice&lt;/a&gt;) for more information on the rights available to me under the GDPR." id="LabelText" />
    <span class="exist-customer__label">Are you a EU resident individual?</span><br>
    <label for="residentYesId">
        <input type="radio" id="residentYesId" name="Resident" class="sample Yes" />
        Yes
    </label>
    <label for="residentNoId">
        <input type="radio" id="residentNoId" name="Resident"  class="sample No" />
        No
    </label>
    <div id="divText" style="display: none" value="">
