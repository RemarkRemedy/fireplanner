---
interface Props {
  categories: string[];
  activeCategory?: string;
}

const { categories, activeCategory } = Astro.props;
---

<nav aria-label="Category filter" class="font-ui mb-8 flex flex-wrap gap-2">
  <a
    href="/blog"
    class:list={[
      'editorial-chip transition-colors',
      !activeCategory
        ? 'editorial-chip-active'
        : 'hover:border-primary/30 hover:text-foreground',
    ]}
  >
    All
  </a>
  {categories.map((cat) => (
    <a
      href={`/blog/category/${cat}`}
      class:list={[
        'editorial-chip capitalize transition-colors',
        activeCategory === cat
          ? 'editorial-chip-active'
          : 'hover:border-primary/30 hover:text-foreground',
      ]}
    >
      {cat.replace('-', ' ')}
    </a>
  ))}
</nav>
