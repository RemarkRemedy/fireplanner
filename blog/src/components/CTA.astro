---
interface Props {
  label?: string;
  url?: string;
  description?: string;
}

const {
  label = 'Try the FIRE Calculator',
  url = '/',
  description = 'Plan your retirement with CPF projections, Monte Carlo simulations, and 12 withdrawal strategies.',
} = Astro.props;
---

<aside class="not-prose my-8 rounded-lg border border-primary/20 bg-primary/5 p-6 dark:border-primary/30 dark:bg-primary/10">
  <p class="mb-3 text-base text-foreground">{description}</p>
  <a
    href={url}
    class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
  >
    {label}
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
  </a>
</aside>
