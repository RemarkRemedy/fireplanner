---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  slug: string;
  readingTime?: number;
}

const { title, description, pubDate, category, slug, readingTime } = Astro.props;
const formattedDate = pubDate.toLocaleDateString('en-SG', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="editorial-card group p-6">
  <a href={`/blog/${slug}`} class="block">
    <div class="editorial-meta mb-3 flex flex-wrap items-center gap-2">
      <span class="editorial-kicker">
        {category.replace(/-/g, ' ')}
      </span>
      <span class="text-muted-foreground">&middot;</span>
      <time datetime={pubDate.toISOString()} class="text-muted-foreground">
        {formattedDate}
      </time>
      {readingTime && (
        <>
          <span class="text-muted-foreground">&middot;</span>
          <span class="text-muted-foreground">{readingTime} min read</span>
        </>
      )}
    </div>
    <h2 class="editorial-title mb-2 text-[1.45rem] leading-[1.3] group-hover:text-primary">
      {title}
    </h2>
    <p class="editorial-subtitle">{description}</p>
  </a>
</article>
