---
interface Props {
  headers: string[];
  rows: string[][];
  caption?: string;
}

const { headers, rows, caption } = Astro.props;
---

<div class="font-ui not-prose my-8 overflow-x-auto rounded-[10px] bg-muted/50">
  <table class="w-full border-collapse text-sm">
    {caption && (
      <caption class="px-4 py-3 text-left text-xs font-medium uppercase tracking-[0.03em] text-muted-foreground">
        {caption}
      </caption>
    )}
    <thead>
      <tr>
        {headers.map((header) => (
          <th class="border-b-[1.5px] border-border px-4 py-3 text-left text-xs font-medium uppercase tracking-[0.03em] text-muted-foreground">{header}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          {row.map((cell, j) => (
            <td class:list={['border-b border-border px-4 py-3 align-top text-foreground last:border-b-0', j === 0 && 'font-medium text-foreground']}>
              <Fragment set:html={cell} />
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
