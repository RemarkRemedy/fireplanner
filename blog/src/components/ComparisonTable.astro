---
interface Props {
  headers: string[];
  rows: string[][];
  caption?: string;
}

const { headers, rows, caption } = Astro.props;
---

<div class="not-prose my-8 overflow-x-auto rounded-lg border border-border">
  <table class="w-full text-sm">
    {caption && (
      <caption class="bg-muted px-4 py-2 text-left text-xs font-medium text-muted-foreground">
        {caption}
      </caption>
    )}
    <thead>
      <tr class="border-b border-border bg-muted/50">
        {headers.map((header) => (
          <th class="px-4 py-3 text-left font-medium text-foreground">{header}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row, i) => (
        <tr class:list={['border-b border-border last:border-0', i % 2 === 1 && 'bg-muted/30']}>
          {row.map((cell, j) => (
            <td class:list={['px-4 py-3 text-foreground', j === 0 && 'font-medium']}>
              <Fragment set:html={cell} />
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
