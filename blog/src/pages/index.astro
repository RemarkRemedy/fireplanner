---
import { getCollection } from 'astro:content';
import BlogList from '../layouts/BlogList.astro';
import BlogCard from '../components/BlogCard.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import { toPostSlug } from '../lib/config';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(allPosts.map((p) => p.data.category))].sort();
---

<BlogList
  title="Singapore Personal Finance Blog"
  description="Articles on CPF, SRS, investing, property, and FIRE strategies for Singapore residents."
>
  <header class="mb-10">
    <p class="editorial-kicker mb-3">SG FIRE Planner Journal</p>
    <h1 class="editorial-title mb-3 text-[clamp(1.9rem,4vw,2.7rem)] leading-[1.2]">Blog</h1>
    <p class="editorial-subtitle max-w-2xl">
      Practical guides on CPF, SRS, investing, property, and FIRE strategies for Singapore.
    </p>
  </header>

  <CategoryFilter categories={categories} />

  <div class="grid gap-4">
    {sortedPosts.map((post) => (
      <BlogCard
        title={post.data.title}
        description={post.data.description}
        pubDate={post.data.pubDate}
        category={post.data.category}
        slug={toPostSlug(post.id)}
        readingTime={post.data.readingTime}
      />
    ))}
  </div>

  {sortedPosts.length === 0 && (
    <p class="py-12 text-center text-muted-foreground">No articles yet. Check back soon.</p>
  )}
</BlogList>
