---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import BlogHead from '../components/BlogHead.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import TOC from '../components/TOC.astro';
import Disclaimer from '../components/Disclaimer.astro';
import RelatedPosts from '../components/RelatedPosts.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
  allPosts: CollectionEntry<'blog'>[];
}

const { post, headings, allPosts } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, author, category, tags, readingTime, noindex } = post.data;
const formattedDate = pubDate.toLocaleDateString('en-SG', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title}>
  <Fragment slot="head">
    <BlogHead
      title={title}
      description={description}
      pubDate={pubDate}
      updatedDate={updatedDate}
      heroImage={heroImage}
      author={author}
      slug={post.id}
      noindex={noindex}
    />
  </Fragment>

  <BreadcrumbNav crumbs={[
    { label: category.replace(/-/g, ' ').replace(/\b\w/g, (l) => l.toUpperCase()), href: `/blog/category/${category}` },
    { label: title },
  ]} />

  <article>
    <header class="mb-8">
      <h1 class="mb-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        {title}
      </h1>
      <div class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
        <span>{author}</span>
        <span>&middot;</span>
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        {readingTime && (
          <>
            <span>&middot;</span>
            <span>{readingTime} min read</span>
          </>
        )}
        {updatedDate && (
          <>
            <span>&middot;</span>
            <span>Updated {updatedDate.toLocaleDateString('en-SG', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
          </>
        )}
      </div>
      <div class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="rounded-full bg-muted px-2.5 py-0.5 text-xs text-muted-foreground">
            {tag}
          </span>
        ))}
      </div>
    </header>

    <TOC headings={headings} />

    <Disclaimer />

    <div class="prose prose-slate max-w-none dark:prose-invert prose-headings:scroll-mt-20 prose-a:text-primary prose-a:no-underline hover:prose-a:underline">
      <slot />
    </div>

    <Disclaimer />
  </article>

  <RelatedPosts
    currentSlug={post.id}
    category={category}
    tags={tags}
    allPosts={allPosts}
  />
</BaseLayout>
