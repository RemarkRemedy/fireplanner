---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import BlogHead from '../components/BlogHead.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import TOC from '../components/TOC.astro';
import Disclaimer from '../components/Disclaimer.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { toPostSlug } from '../lib/config';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
  allPosts: CollectionEntry<'blog'>[];
}

const { post, headings, allPosts } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, author, category, tags, readingTime, noindex, tocLabels } = post.data;
const authorName = author || 'SG FIRE Planner';
const slug = toPostSlug(post.id);
const formattedDate = pubDate.toLocaleDateString('en-SG', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const tocHeadings = headings.map((heading) => ({
  ...heading,
  text: tocLabels?.[heading.slug] ?? heading.text,
}));
---

<BaseLayout title={title}>
  <Fragment slot="head">
    <BlogHead
      title={title}
      description={description}
      pubDate={pubDate}
      updatedDate={updatedDate}
      heroImage={heroImage}
      author={authorName}
      slug={slug}
      noindex={noindex}
    />
  </Fragment>

  <BreadcrumbNav crumbs={[
    { label: category.replace(/-/g, ' ').replace(/\b\w/g, (l) => l.toUpperCase()), href: `/blog/category/${category}` },
    { label: title },
  ]} />

  <article class="article-shell lg:grid lg:grid-cols-[248px_minmax(0,1fr)] lg:gap-12">
    <aside class="hidden lg:block lg:self-start lg:sticky lg:top-24">
      <TOC headings={tocHeadings} />
    </aside>

    <div class="min-w-0">
      <header class="mb-10">
        <h1 class="font-reading mb-3 text-[clamp(1.8rem,4vw,2.4rem)] font-semibold leading-[1.25] tracking-[-0.02em] text-foreground">
        {title}
        </h1>
        <div class="font-ui flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
          <span>{authorName}</span>
          <span>&middot;</span>
          <time datetime={pubDate.toISOString()}>{formattedDate}</time>
          {readingTime && (
            <>
              <span>&middot;</span>
              <span>{readingTime} min read</span>
            </>
          )}
          {updatedDate && (
            <>
              <span>&middot;</span>
              <span>Updated {updatedDate.toLocaleDateString('en-SG', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
            </>
          )}
        </div>
        <div class="font-ui mt-3 flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="rounded-full bg-muted px-2.5 py-0.5 text-xs text-muted-foreground">
              {tag}
            </span>
          ))}
        </div>
      </header>

      <div class="lg:hidden">
        <TOC headings={tocHeadings} variant="mobile" />
      </div>

      <div class="article-prose prose-headings:scroll-mt-20">
        <slot />
      </div>

      <Disclaimer />
    </div>
  </article>

  <RelatedPosts
    currentSlug={post.id}
    category={category}
    tags={tags}
    allPosts={allPosts}
  />
</BaseLayout>
